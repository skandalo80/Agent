# Copia a clientes/nortex/.env en el servidor (no se sube a GitHub).
# Solo va lo que es distinto de la cuenta principal; lo demás (IG_APP_SECRET,
# IG_VERIFY_TOKEN, ANTHROPIC_API_KEY, Google...) se toma del .env principal.
PORT=8002
# Token de @nortex_uniformes (Meta > API de Instagram > Generar tokens).
IG_ACCESS_TOKEN=pega-aqui-el-token-de-nortex
MAIL_FROM_NAME=Nortex Uniformes
