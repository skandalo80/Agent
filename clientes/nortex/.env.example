# Copia a clientes/nortex/.env en el servidor (no se sube a GitHub).
# Solo va lo que es distinto de la cuenta principal; lo demás (IG_APP_SECRET,
# IG_VERIFY_TOKEN, ANTHROPIC_API_KEY, Google...) se toma del .env principal.
PORT=8002
# Token de @nortex_uniformes (Meta > API de Instagram > Generar tokens).
IG_ACCESS_TOKEN=pega-aqui-el-token-de-nortex
MAIL_FROM_NAME=Nortex Uniformes
# Hojas de Google con el catálogo y las existencias (el link completo, con #gid=).
SHEET_CATALOG=https://docs.google.com/spreadsheets/d/1nmI5mLVs2OrtyapbzMVXikWAeVkj3C2JC5MPltkfvQo/edit#gid=2028608343
SHEET_INVENTORY=https://docs.google.com/spreadsheets/d/1-XngcItbtAzJnOeUmZXULf_oERcMRc5XZkS8tBsRld4/edit#gid=395667474
# Hoja con las reglas de comentarios: link de la publicación | palabra clave | mensaje por DM.
# SHEET_COMMENTS=https://docs.google.com/spreadsheets/d/.../edit
# Administradores: tu id de Instagram como lo ve esta cuenta (sale en el log como
# "DM de <id>" cuando le escribes). Con él puedes publicar mandándole fotos al bot
# y reactivar conversaciones en pausa. Varios, separados por comas.
# ADMIN_IG_IDS=
# Reporte semanal (lunes 9:00): a qué correo llega. A los administradores también les llega por DM.
# REPORT_EMAIL=
# REPORT_DAY=1    (1=lunes ... 7=domingo)
# REPORT_HOUR=9
# Ocultar comentarios de spam en todas las publicaciones (1 = sí).
HIDE_SPAM=1
