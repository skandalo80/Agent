# Cabeceras de seguridad. Van en un snippet porque handle_errors no hereda las del sitio.
(cabeceras-web) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self' https://console.skandar.online https://bot.skandar.online; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

skandar.online {
    root * /var/www/skandar.online
    encode gzip

    # Skandi, el chat de la web: lo atiende el bot (sus cabeceras dejan abrirlo en un
    # iframe de esta misma web; ver igbot/skandi.py).
    @ayuda path /ayuda /ayuda/*
    handle @ayuda {
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            -Server
        }
        reverse_proxy 127.0.0.1:8001
    }

    handle {
        import cabeceras-web
        try_files {path} {path}.html
        file_server
    }

    handle_errors 404 {
        import cabeceras-web
        rewrite * /404.html
        file_server
    }
}

www.skandar.online {
    redir https://skandar.online{uri} permanent
}
