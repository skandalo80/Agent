# Copia este archivo a .env en el servidor y rellénalo. Nunca subas .env a GitHub.
IG_VERIFY_TOKEN=inventa-una-frase-larga-aqui
IG_APP_SECRET=
# Token inicial; el bot lo renueva solo cada semana y guarda el nuevo en data/bot.db.
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0
# Otras cuentas de la misma app (ver "Varias cuentas" en el README). Este proceso
# les reenvía los avisos de Meta, p. ej.: http://127.0.0.1:8002/webhook
# FORWARD_WEBHOOKS=

# Clave de la API de Claude (console.anthropic.com > API keys).
ANTHROPIC_API_KEY=

# Opcionales (estos son los valores por defecto):
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# HISTORY_WINDOW=20
# DEBOUNCE_SECONDS=5
# MAX_CONCURRENT=4
# DB_PATH=data/bot.db

# --- Agenda y correo con tu Google (ver "Agenda y correo" en el README) ---
# Sin GOOGLE_REFRESH_TOKEN el bot funciona igual, pero sin agendar ni mandar correos.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# MAIL_FROM=tu-correo@gmail.com
# MAIL_FROM_NAME=Tu nombre o el de tu negocio
# MAIL_CC=            (copia extra de cada correo; opcional)
# TIMEZONE=America/Mexico_City
# BUSINESS_HOURS=09:00-18:00
# BUSINESS_DAYS=1,2,3,4,5      (1=lunes ... 7=domingo)
# MEETING_MINUTES=30
# MIN_NOTICE_HOURS=2
# MAX_MEETINGS_PER_USER=2
# MAX_EMAILS_PER_USER_PER_DAY=3

# --- Ventas: cotizaciones y pasar a humano ---
# Paquetes y precios en negocio/catalogo.yaml (las cotizaciones necesitan Google configurado).
# Dirección pública del bot, para mandar el PDF de la cotización por DM:
PUBLIC_URL=https://bot.skandar.online
# OWNER_EMAIL=          (a quién avisar cuando alguien pide una persona; por defecto MAIL_FROM)
# HUMAN_PAUSE_HOURS=12  (horas que el bot se calla si contestas tú o pasa a humano)
# CATALOG_PATH=negocio/catalogo.yaml
# QUOTES_DIR=data/cotizaciones
