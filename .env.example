# Copia este archivo a .env en el servidor y rellénalo. Nunca subas .env a GitHub.
IG_VERIFY_TOKEN=inventa-una-frase-larga-aqui
IG_APP_SECRET=
# Token inicial; el bot lo renueva solo cada semana y guarda el nuevo en data/bot.db.
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0
# Cuentas de clientes que atiende este mismo proceso (carpetas de clientes/ con
# su .env; ver "Varias cuentas" en el README), p. ej.: CUENTAS=cafelunar,otra
# CUENTAS=
# MAX_CONCURRENT_PER_ACCOUNT=3   (respuestas a la vez de una misma cuenta)

# Clave de la API de Claude (console.anthropic.com > API keys).
ANTHROPIC_API_KEY=

# Opcionales (estos son los valores por defecto):
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# HISTORY_WINDOW=20
# DEBOUNCE_SECONDS=5
# MAX_CONCURRENT=4
# DB_PATH=data/bot.db

# --- Agenda y correo con tu Google (ver "Agenda y correo" en el README) ---
# Sin GOOGLE_REFRESH_TOKEN el bot funciona igual, pero sin agendar ni mandar correos.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# MAIL_FROM=tu-correo@gmail.com
# MAIL_FROM_NAME=Tu nombre o el de tu negocio
# RESPALDO_EMAIL=otro-correo@gmail.com  (a dónde llega el respaldo semanal de las bases; si no, a MAIL_FROM)
# MAIL_CC=            (copia extra de cada correo; opcional)
# TIMEZONE=America/Mexico_City
# BUSINESS_HOURS=09:00-18:00
# BUSINESS_DAYS=1,2,3,4,5      (1=lunes ... 7=domingo)
# MEETING_MINUTES=30
# MIN_NOTICE_HOURS=2
# MAX_MEETINGS_PER_USER=2
# MAX_EMAILS_PER_USER_PER_DAY=3

# --- Ventas: cotizaciones y pasar a humano ---
# Paquetes y precios en negocio/catalogo.yaml (las cotizaciones necesitan Google configurado).
# Dirección pública del bot, para mandar el PDF de la cotización por DM:
PUBLIC_URL=https://console.skandar.online
# OWNER_EMAIL=          (a quién avisar cuando alguien pide una persona; por defecto MAIL_FROM)
# HUMAN_PAUSE_HOURS=12  (horas que el bot se calla si contestas tú o pasa a humano)

# Límites contra abuso (opcionales; estos son los valores por defecto)
# MAX_REPLIES_PER_USER_PER_DAY=30  (respuestas por persona al día; luego avisa una vez y se calla)
# MAX_MESSAGE_CHARS=1000  (lo que pasa de esto en un DM se corta)
# DAILY_BUDGET_USD=5  (gasto máximo en Claude por día y cuenta; 0 = sin límite)
# PLAN=basico  (basico | community | pro_crm: pone IMAGES/MESSAGES/POSTS_PER_MONTH de su plan; lo que escribas abajo gana)
# MESSAGES_PER_MONTH=0  (respuestas del asistente que incluye el plan al mes; Básico 1000, Community 2000, Pro 5000; solo se muestra, 0 = sin tope)
# CATALOG_PATH=negocio/catalogo.yaml
# QUOTES_DIR=data/cotizaciones

# --- Conectar cuentas de clientes (skandar.online/conectar) ---
# Panel de Meta > Instagram > API de Instagram con inicio de sesión de Instagram:
# "Instagram app ID" y "Instagram app secret". Sin IG_APP_ID la página no conecta.
# IG_APP_ID=
# IG_OAUTH_SECRET=      (si se deja vacío se usa IG_APP_SECRET)
# SITE_URL=https://skandar.online
# Login de Facebook (conectar la página de Facebook y, con ella, su Instagram): el "Identificador de la app"
# de Meta (Configuración > Básica); el secreto es IG_APP_SECRET. Sin FB_APP_ID no sale el botón.
# FB_APP_ID=
# FB_CONFIG_ID=  (ID de configuración del login de Facebook para empresas; si está, se usa en vez de FB_SCOPES)
# IG_VIA=facebook  (en el .env de un cliente que entró con Facebook: su token es el de su página; lo pone el panel)

# --- Imágenes para contenido (opcional) ---
# Las pinta OpenAI (GPT Image). Clave de platform.openai.com/api-keys; pon el tope de
# gasto en tu cuenta de OpenAI (Settings > Limits): al llegar, no se generan imágenes.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare   (rápido; gpt-image-2.5-sunburst da más calidad)
# OPENAI_IMAGE_QUALITY=medium              (low, medium o high)
# OPENAI_IMAGE_SIZE=1024x1536              (vertical; el servidor la recorta a 4:5)
# IMAGE_PROVIDER=openai                    (gemini solo para volver al anterior, con GEMINI_API_KEY)
# IMAGE_COST_USD=0.05   (cuenta para DAILY_BUDGET_USD)
# IMAGES_PER_MONTH=0    (imágenes incluidas al mes en esta cuenta; 0 = sin contenido)
# POSTS_PER_MONTH=0     (posts incluidos al mes; Community 12, Pro 20; solo se muestra, 0 = sin tope)
# EXTRA_IMAGE_USD=0.25  (precio que ve el cliente por imagen pasado su cupo)
# CONTENT_MODEL=claude-sonnet-5-5   (quién escribe los posts del panel)

# --- Conecta tu Shopify (opcional) ---
# App de Skandar en Shopify (dev.shopify.com > Apps > crear app). En su configuración:
# URL de la app https://console.skandar.online/panel/shopify, redirección
# https://console.skandar.online/panel/shopify/callback, y los webhooks de privacidad
# https://console.skandar.online/shopify/webhooks/customers-data-request (y customers-redact, shop-redact).
# Los avisos de pedidos (orders/create y orders/cancelled) se dan de alta solos al conectar cada tienda.
# Permisos: read_products, read_inventory, read_locations, read_orders.
# SHOPIFY_API_KEY=      (Client ID)
# SHOPIFY_API_SECRET=   (Client secret)
# SHOPIFY_API_VERSION=2025-10
